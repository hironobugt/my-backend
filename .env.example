# AWS Configuration
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB Tables (ローカル開発用)
METADATA_TABLE=glacier-archive-metadata-dev
CUSTOMER_TABLE=glacier-customers-dev
USAGE_TABLE=glacier-usage-dev
USAGE_EVENTS_TABLE=glacier-usage-events-dev

# S3 Bucket
ARCHIVE_BUCKET=glacier-archive-dev-your-account-id

# Cognito (ローカル開発では使用しないが設定必要)
USER_POOL_ID=ap-northeast-1_xxxxxxxxx
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# CloudFront Configuration (本番環境用)
CLOUDFRONT_DOMAIN=d1234567890123.cloudfront.net

# Local Development Configuration
LOCAL_SERVER_URL=http://localhost:3000

# Server Configuration
PORT=3000
NODE_ENV=development